<string name="tutorial_step1_title">Welcome to GlucoTime</string>
<string name="tutorial_step1_body">Let\'s take a quick tour of how to use the app to track your blood glucose.</string>
<string name="tutorial_step2_title">Add a Reading</string>
<string name="tutorial_step2_body">Tap this button on the Home screen to quickly add a new glucose reading.</string>
<string name="tutorial_step3_title">Measurement Types</string>
<string name="tutorial_step3_body">You can specify if the reading was Fasting, Before Meal, After Meal, or Random.</string>
<string name="tutorial_step4_title">Track Your History</string>
<string name="tutorial_step4_body">View all your past readings in the History tab. You can easily edit or delete them.</string>
<string name="tutorial_step5_title">Set Reminders</string>
<string name="tutorial_step5_body">Never forget a reading! Add daily or weekly reminders in the Reminders tab.</string>
<string name="tutorial_step6_title">Data Analysis</string>
<string name="tutorial_step6_body">Check your glucose trends and statistics over time in the Analysis section.</string>
<string name="tutorial_step7_title">Multiple Profiles</string>
<string name="tutorial_step7_body">Manage readings for different family members using the Users section in Settings.</string>
<string name="tutorial_step8_title">Export Data</string>
<string name="tutorial_step8_body">Need to share with your doctor? Export your readings to Excel or PDF from Settings.</string>
<string name="tutorial_finish">Got it!</string>
<string name="date_picker_confirm">Confirm</string>

<resources>
    <style name="Theme.GlucoTime" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/glucotime_electric</item>
    </style>

    <style name="Theme.GlucoTime.Starting" parent="Theme.SplashScreen">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/glucotime_electric</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_glucotime_logo</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.GlucoTime</item>
    </style>
</resources>
